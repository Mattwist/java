package ru.mirea.lab4;

import java.util.ArrayList;
import java.util.List;
import java.util.Scanner;

public class Shop {
    private final Category[] categories;
    private final User[] users;
    private final List<Product> cart = new ArrayList<>();

    public Shop(Category[] categories, User[] users) {
        this.categories = categories;
        this.users = users;
    }

    public boolean login(String login, String password) {
        for (User u : users) {
            if (u.authenticate(login, password)) {
                System.out.println("Добро пожаловать, " + u.getLogin() + "!");
                return true;
            }
        }
        return false;
    }

    public void showCategories() {
        System.out.println("=== Каталоги ===");
        for (int i = 0; i < categories.length; i++)
            System.out.println((i + 1) + ". " + categories[i]);
    }

    public void showProducts(int idx) {
        Product[] p = categories[idx].getProducts();
        System.out.println("=== " + categories[idx].getName() + " ===");
        for (int i = 0; i < p.length; i++)
            System.out.println((i + 1) + ". " + p[i]);
    }

    public void addToCart(Product p) {
        cart.add(p);
        System.out.println("Добавлено: " + p);
    }

    public void showCart() {
        if (cart.isEmpty()) { System.out.println("Корзина пуста."); return; }
        System.out.println("=== Корзина ===");
        double total = 0;
        for (Product p : cart) { System.out.println(p); total += p.getPrice(); }
        System.out.println("Итого: " + total + " руб.");
    }

    public void checkout() {
        if (cart.isEmpty()) { System.out.println("Корзина пуста."); return; }
        double total = 0;
        for (Product p : cart) total += p.getPrice();
        System.out.println("Покупка совершена на сумму " + total + " руб.");
        cart.clear();
    }

    public static void main(String[] args) {
        Category[] categories = {
                new Category("Электроника", new Product[]{
                        new Product("Ноутбук", 75000),
                        new Product("Смартфон", 30000),
                        new Product("Наушники", 5000)
                }),
                new Category("Книги", new Product[]{
                        new Product("Java. Полное руководство", 2500),
                        new Product("Алгоритмы", 3000)
                })
        };
        User[] users = { new User("admin", "1234"), new User("user", "qwerty") };

        Shop shop = new Shop(categories, users);
        Scanner sc = new Scanner(System.in);

        boolean ok = false;
        while (!ok) {
            System.out.print("Логин: "); String l = sc.nextLine();
            System.out.print("Пароль: "); String p = sc.nextLine();
            ok = shop.login(l, p);
            if (!ok) System.out.println("Неверный логин/пароль.\n");
        }

        while (true) {
            System.out.println("\n1. Каталоги | 2. Товары | 3. Корзина | 4. Купить | 0. Выход");
            System.out.print("Выбор: ");
            int choice = Integer.parseInt(sc.nextLine());
            switch (choice) {
                case 1: shop.showCategories(); break;
                case 2:
                    shop.showCategories();
                    System.out.print("Номер категории: ");
                    int c = Integer.parseInt(sc.nextLine()) - 1;
                    if (c < 0 || c >= categories.length) { System.out.println("Нет такой."); break; }
                    shop.showProducts(c);
                    System.out.print("Номер товара (0 — отмена): ");
                    int pIdx = Integer.parseInt(sc.nextLine()) - 1;
                    if (pIdx >= 0 && pIdx < categories[c].getProducts().length)
                        shop.addToCart(categories[c].getProducts()[pIdx]);
                    break;
                case 3: shop.showCart(); break;
                case 4: shop.checkout(); break;
                case 0: System.out.println("Пока!"); sc.close(); return;
                default: System.out.println("Неверный пункт.");
            }
        }
    }
}
