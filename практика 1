Задание 4 
package ru.mirea.lab1;

import java.util.Scanner;

public class Task4 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Сколько чисел будет в массиве? ");
        int n = sc.nextInt();

        int[] arr = new int[n];
        System.out.println("Введи " + n + " целых чисел:");
        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        
        int sumWhile = 0;
        int i = 0;
        while (i < arr.length) {
            sumWhile += arr[i];
            i++;
        }

       
        int sumDoWhile = 0;
        int j = 0;
        if (arr.length > 0) {
            do {
                sumDoWhile += arr[j];
                j++;
            } while (j < arr.length);
        }

       
        int max = arr[0];
        int min = arr[0];
        for (int k = 1; k < arr.length; k++) {
            if (arr[k] > max) max = arr[k];
            if (arr[k] < min) min = arr[k];
        }

        System.out.println("Сумма (while):    " + sumWhile);
        System.out.println("Сумма (do while): " + sumDoWhile);
        System.out.println("Максимум: " + max);
        System.out.println("Минимум:  " + min);

        sc.close();
    }
}
