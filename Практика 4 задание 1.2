package ru.mirea.lab4;

public class Task1 {
    public static void main(String[] args) {
        // 1) Любимое время года
        Season favorite = Season.SUMMER;
        System.out.println("Любимое время года: " + favorite);
        System.out.println("Температура: " + favorite.getAverageTemperature());
        System.out.println("Описание: " + favorite.getDescription());
        System.out.println();

        // 2) Метод со switch
        printSeasonMessage(Season.WINTER);
        printSeasonMessage(Season.SUMMER);
        System.out.println();

        // 6) Все времена года в цикле
        for (Season s : Season.values()) {
            System.out.printf("%-7s | %6.1f°C | %s%n",
                    s, s.getAverageTemperature(), s.getDescription());
        }
    }

    public static void printSeasonMessage(Season season) {
        switch (season) {
            case SUMMER: System.out.println("Я люблю лето"); break;
            case WINTER: System.out.println("Я люблю зиму"); break;
            case SPRING: System.out.println("Я люблю весну"); break;
            case AUTUMN: System.out.println("Я люблю осень"); break;
        }
    }
}
