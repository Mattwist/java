import java.text.SimpleDateFormat;
import java.util.Calendar;
import java.util.Date;
import java.util.Scanner;

public class Task4 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        
        System.out.println("Введите данные для создания даты:");
        System.out.print("Год: ");
        int year = sc.nextInt();
        System.out.print("Месяц (1-12): ");
        int month = sc.nextInt() - 1; // В Calendar месяцы с 0
        System.out.print("Число: ");
        int day = sc.nextInt();
        System.out.print("Часы: ");
        int hour = sc.nextInt();
        System.out.print("Минуты: ");
        int minute = sc.nextInt();

        // Создание Calendar
        Calendar cal = Calendar.getInstance();
        cal.set(year, month, day, hour, minute, 0);
        cal.set(Calendar.MILLISECOND, 0);
        
        // Создание Date из Calendar
        Date date = cal.getTime();

        SimpleDateFormat sdf = new SimpleDateFormat("dd.MM.yyyy HH:mm:ss");
        System.out.println("Создан объект Date: " + sdf.format(date));
        System.out.println("Создан объект Calendar: " + cal.getTime().toString());
    }
}
