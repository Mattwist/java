package ru.mirea.lab2;

import java.util.Scanner;

public class TestAuthor {
    public static void main(String[] args) {
        
        Author a1 = new Author("Tan Ah Teck", "ahTeck@somewhere.com", 'm');
        System.out.println(a1);           // использует toString()
        System.out.println("Имя:    " + a1.getName());
        System.out.println("Email:  " + a1.getEmail());
        System.out.println("Gender: " + a1.getGender());

        
        a1.setEmail("new.email@mail.com");
        System.out.println("После setEmail: " + a1);

        
        Scanner sc = new Scanner(System.in);
        System.out.println("\nВведите данные нового автора:");
        System.out.print("Имя: ");
        String name = sc.nextLine();
        System.out.print("Email: ");
        String email = sc.nextLine();
        System.out.print("Пол (m/f/u): ");
        char gender = sc.next().charAt(0);

        Author a2 = new Author(name, email, gender);
        System.out.println("Создан автор: " + a2);

        sc.close();
    }
}
